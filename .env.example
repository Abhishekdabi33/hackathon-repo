# ==============================================================================
# HACKATHON ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys. DO NOT COMMIT .env TO GIT!
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# AI & Model Configuration
DEVICE=cuda            # "cuda" (NVIDIA GPU) or "cpu"
MODEL_PATH=./ai_engine/checkpoints/best_model.pt
HF_TOKEN=              # Hugging Face access token (optional for gated models)

# Cloud GPU Acceleration (Kaggle 2x T4 or Colab via ngrok public URL)
CLOUD_GPU_URL=          # e.g., https://xxxx.ngrok-free.app (leave empty if using Gemini API)

# LLM API (Google AI Studio - Free Gemma & Gemini access, 0 local GPU needed!)
GEMINI_API_KEY=         # Get free key at https://aistudio.google.com
OPENAI_API_KEY=
GROQ_API_KEY=

# Database / Storage (if applicable)
DATABASE_URL=sqlite:///./hackathon.db
