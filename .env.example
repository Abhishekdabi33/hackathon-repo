# ==============================================
# HACKATHON PROJECT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ==============================================

# General
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI & LLM Services (Choose Local or Cloud)
AI_PROVIDER=hybrid  # 'local', 'ollama', 'gemini', 'openai'
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Cloud AI API Keys (Optional fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8000
